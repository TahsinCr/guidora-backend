# Copy to .env and replace every secret before starting the stack.
# .env is local-only and is excluded from Git.

# Runtime
ASPNETCORE_ENVIRONMENT=Production
WEBAPI_PORT=8080
WEB_CLIENT_ORIGIN=http://localhost:4200
FORWARDED_HEADERS_KNOWN_PROXIES_0=

# PostgreSQL
POSTGRES_DB=guidora
POSTGRES_USER=guidora
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_PORT=5432
INFRA_BIND_ADDRESS=127.0.0.1
DATABASE_APPLY_MIGRATIONS_ON_STARTUP=true

# Redis
REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb
REDIS_CONTAINER_MEMORY_LIMIT=320m

# Optional RabbitMQ profile: docker compose --profile messaging up
RABBITMQ_USER=guidora
RABBITMQ_PASSWORD=replace-with-a-long-random-rabbitmq-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# JWT and verification signal keys must be independent random secrets.
TOKEN_OPTIONS__SECURITYKEY=replace-with-a-random-signing-key-of-at-least-32-bytes
TOKEN_OPTIONS__ISSUER=Guidora
TOKEN_OPTIONS__AUDIENCE=Guidora
TOKEN_OPTIONS__ACCESS_TOKEN_EXPIRATION_MINUTES=15
TOKEN_OPTIONS__REFRESH_TOKEN_EXPIRATION_DAYS=30
TOKEN_OPTIONS__REMEMBER_ME_EXPIRATION_DAYS=90
TOKEN_OPTIONS__SESSION_ABSOLUTE_EXPIRATION_DAYS=180
TOKEN_OPTIONS__CLOCK_SKEW_SECONDS=30
COMMUNITY_VERIFICATION_SIGNAL_HASH_KEY=replace-with-a-different-random-key-of-at-least-32-bytes

# Initial administrator. Enabled is false in the template to prevent accidental
# use of a sample credential. Set true and provide a unique random password (32+ chars).
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=tahsincr
BOOTSTRAP_ADMIN_EMAIL=tahsincrs@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=

# Email verification (SMTP uses STARTTLS). Set enabled=true only after all
# provider details are configured. Gmail requires an App Password, not account password.
EMAIL_VERIFICATION_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_FROM=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=

# Request rate limits
RATE_LIMIT_LOGIN_PERMIT_LIMIT=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_PERMIT_LIMIT=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_REFRESH_PERMIT_LIMIT=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_EMAIL_REQUEST_PERMIT_LIMIT=3
RATE_LIMIT_EMAIL_REQUEST_WINDOW_SECONDS=3600
RATE_LIMIT_EMAIL_CONFIRM_PERMIT_LIMIT=10
RATE_LIMIT_EMAIL_CONFIRM_WINDOW_SECONDS=600
RATE_LIMIT_EMAIL_IP_PERMIT_LIMIT=120
RATE_LIMIT_EMAIL_IP_WINDOW_SECONDS=3600

# Host and logging
ALLOWED_HOSTS=*
LOG_LEVEL_DEFAULT=Information
LOG_LEVEL_ASPNETCORE=Warning

# Optional authorization seed synchronization
AUTHORIZATION_SYNC_OPERATION_CLAIMS_ON_STARTUP=false
