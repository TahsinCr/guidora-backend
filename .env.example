POSTGRES_DB=guidora
POSTGRES_USER=guidora
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432

REDIS_PASSWORD=change-this-redis-password
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb
REDIS_CONTAINER_MEMORY_LIMIT=320m

RABBITMQ_USER=guidora
RABBITMQ_PASSWORD=change-this-rabbitmq-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

WEBAPI_PORT=8080
TOKEN_OPTIONS__SECURITYKEY=change-this-development-signing-key
AUTHORIZATION_SYNC_OPERATION_CLAIMS_ON_STARTUP=false
